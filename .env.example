# ============================================================
# SERVIMARKET — Variables de entorno
# Copiá este archivo como .env y completá los valores.
#
# IMPORTANTE: este archivo (.env) es SOLO para el frontend (variables VITE_*).
# Los secrets de las Edge Functions NO van acá — se cargan con
# `supabase secrets set` (ver la sección de referencia más abajo).
# ============================================================

# --- SUPABASE (requerido) ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# --- ADMOB (opcional, solo build mobile) ---
# Ad unit IDs de los banners (formato con "/"). Los conseguís en https://admob.google.com
# Si no los completás o VITE_ADMOB_USE_REAL no es "true", se usan los IDs de test de Google.
VITE_ADMOB_BANNER_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
VITE_ADMOB_BANNER_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
VITE_ADMOB_USE_REAL=false


# ============================================================
# REFERENCIA — Secrets de Supabase Edge Functions
# NO van en este archivo. Cargalos con:
#   supabase secrets set NOMBRE=valor
# ============================================================
#
# --- MercadoPago ---
# MP_ACCESS_TOKEN            Token del platform (Modelo A). Sandbox: TEST-...
# MP_CLIENT_ID               Application ID de tu app MP (OAuth Marketplace)
# MP_CLIENT_SECRET           Access token de la app MP (usado como client_secret en OAuth)
# MP_OAUTH_REDIRECT_URI      https://TU_PROJECT.supabase.co/functions/v1/mp-oauth-callback
# MP_OAUTH_STATE_SECRET      String hex aleatorio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MP_WEBHOOK_SECRET          Clave de firma del webhook (panel MP → Webhooks)
# MP_USE_MARKETPLACE         "false" (Modelo A) o "true" (split automático, requiere Marketplace aprobado)
# APP_URL                    URL de la app (http://localhost:5173 en dev; dominio Vercel en prod)
#
# --- Firebase (push notifications) ---
# FIREBASE_PROJECT_ID        Del service account JSON (project_id)
# FIREBASE_CLIENT_EMAIL      Del service account JSON (client_email)
# FIREBASE_PRIVATE_KEY       Del service account JSON (private_key, con los \n incluidos, entre comillas)
#
# (SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY ya están disponibles automáticamente
#  dentro de las Edge Functions; no hace falta setearlos.)
